# ===================================================
# BFSI 2030 - CIO Association Rajasthan Chapter
# Environment Variables & Configuration Reference
# ===================================================

# ---------------------------------------------------
# 1. Admin Authentication
# ---------------------------------------------------
# Admin Password for web console login (/admin/login)
ADMIN_PASSWORD=bfsi2030admin

# Admin 4-digit PIN for backup API header authentication (x-admin-pin)
ADMIN_PIN=2030

# ---------------------------------------------------
# 2. Database Configuration (for Vercel / Production)
# ---------------------------------------------------
# Free cloud SQLite database on Turso (https://turso.tech)
# 1. Create a database on Turso
# 2. Add these two variables to your Vercel Project Settings -> Environment Variables
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# (Note: For local development, if TURSO variables are omitted,
# the app automatically falls back to a local SQLite file file:local.db)
